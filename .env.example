# Copy this file to ".env" (never commit ".env") and fill in the values.
# On FadeHost (or any host) set the same names in the hosting dashboard instead.

# Port the HTTP server listens on. Hosting platforms usually set this for you.
PORT=3000

# "development" or "production". The /dev/message simulator is DISABLED in production.
NODE_ENV=development

# "mock"  = local testing, no Meta credentials needed, never sends real WhatsApp messages.
# "cloud" = real WhatsApp Cloud API mode; all variables below become required.
WHATSAPP_MODE=mock

# Cloud mode only: access token from Meta (temporary test tokens expire, usually within ~24h).
WHATSAPP_ACCESS_TOKEN=

# Cloud mode only: the Phone Number ID (NOT the phone number) from WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=

# Cloud mode only: any secret string you invent. Paste the same value into Meta's webhook
# "Verify token" field.
WHATSAPP_VERIFY_TOKEN=

# Cloud mode: Meta App Secret (App settings > Basic). Used to verify the X-Hub-Signature-256
# header on every POST /webhook. Required when NODE_ENV=production.
WHATSAPP_APP_SECRET=

# Cloud mode only: Graph API version in the form v<major>.<minor>, e.g. the version shown
# in Meta's API Setup page / the sample cURL command. Deliberately left blank here so the
# project does not hardcode an assumed "current" version.
WHATSAPP_API_VERSION=

# MongoDB (optional) - connect to your existing MongoDB Atlas cluster.
# Leave both blank to run without a database (mock mode continues to work).
# Never commit .env. Set these in your hosting dashboard instead.
MONGODB_URI=
MONGODB_DATABASE=

# Admin phone numbers (optional) - comma-separated WhatsApp sender IDs allowed to
# run admin commands such as !setclanmission and !setnextreset.
# Leave blank to deny all admin actions by default.
# Never commit .env. Set these in your hosting dashboard instead.
WHATSAPP_ADMIN_NUMBERS=

# --- Chapter 4 + 5: WhatsApp Template Reminder Configuration ---

# Enable automatic reminder delivery. Must be "true" to activate.
# DEFAULT: disabled. Only enable after Meta templates are approved.
REMINDER_ENABLED=false

# Minutes before the reset time to send the reminder.
# 0 = send exactly at reset time. Must be >= 0.
REMINDER_OFFSET_MINUTES=0

# How often the scheduler polls for due jobs (minutes). Must be >= 1.
REMINDER_POLL_INTERVAL_MINUTES=5
